    var btn=document.createElement('button');
    btn.className='cf-btn'+(state.callingFavs.indexOf(sk)>=0?' selected':'');
    btn.textContent=sk;
    btn.onclick=function(){
      var idx=state.callingFavs.indexOf(sk);
      if(idx>=0){ state.callingFavs.splice(idx,1); }
      else if(state.callingFavs.length<2){ state.callingFavs.push(sk); }
      renderCallingFavs();
      document.getElementById('btn2next').disabled=state.callingFavs.length<2;
    };
    opts.appendChild(btn);
