}

function getBaseSkill(sk) {
  if(!state.culture) return 0;
  return CULTURES[state.culture].skills[sk]||0;
}

function getSkillRank(sk) {
  return getBaseSkill(sk)+(state.xpSkills[sk]||0);
}

// BUGFIX: Allow both primary (Rank 2) and secondary (Rank 1) weapon skills correctly
function getCombatBase(cp) {
  if(!state.culture) return 0;
  var c=CULTURES[state.culture];
  if (cp === c.mainCombat[0]) return c.mainRank;
  if (cp === c.mainCombat[1]) return c.extraRank;
  return 0;
}

function getCombatRank(cp) { return getCombatBase(cp)+(state.xpCombat[cp]||0); }

function getAllFavSkills() {
  var favs=[];
  if(state.favouredSkill) favs.push(state.favouredSkill);
  state.callingFavs.forEach(function(s){ if(favs.indexOf(s)<0) favs.push(s); });
  return favs;
}

function xpSpent() {
  var t=0;
  Object.keys(state.xpSkills).forEach(function(sk){
    var base=getBaseSkill(sk);
    for(var i=0;i<state.xpSkills[sk];i++){
      var lvl=base+i+1;
      t+=(lvl<=1?1:lvl<=2?2:lvl<=3?3:5);
    }
  });
  Object.keys(state.xpCombat).forEach(function(cp){
    var base=getCombatBase(cp);
    for(var i=0;i<state.xpCombat[cp];i++){
      var lvl=base+i+1;
      t+=(lvl<=1?2:lvl<=2?4:6);
    }
  });
  return t;
}

function renderXP() {
  if(!state.culture) return;
  var sec=document.getElementById('xpSection');
  var left=10-xpSpent();
  var skillNames=Object.keys(CULTURES[state.culture].skills);
  var combatTypes=['Axes','Bows','Spears','Swords'];
  sec.innerHTML=
    '<div class="xp-header-row"><div class="xp-pool-label">'+T('xpLeft')+'</div><div class="xp-left">'+left+'<span style="font-size:14px;color:var(--gold-dark)"> / 10</span></div></div>'+
    '<div class="xp-tabs">'+
      '<button class="xp-tab'+(currentXPTab==='skills'?' active':'')+'\" onclick="switchXPTab(\'skills\')">'+T('skills')+'</button>'+
      '<button class="xp-tab'+(currentXPTab==='combat'?' active':'')+'\" onclick="switchXPTab(\'combat\')">'+T('combat')+'</button>'+
    '</div>'+
    '<div id="xpSkillsList" style="display:'+(currentXPTab==='skills'?'block':'none')+'"></div>'+
    '<div id="xpCombatList" style="display:'+(currentXPTab==='combat'?'block':'none')+'"></div>';

  var sl=document.getElementById('xpSkillsList');
  var favs=getAllFavSkills();
  skillNames.forEach(function(sk){
    var cur=getSkillRank(sk);
    var isFav=favs.indexOf(sk)>=0;
    var left2=10-xpSpent();
    var nextCost=cur+1<=1?1:cur+1<=2?2:cur+1<=3?3:5;
    var row=document.createElement('div');
    row.className='xp-skill-row';
    row.innerHTML='<div class="xp-skill-name'+(isFav?' is-fav':'')+'">'+sk+(isFav?' ★':'')+'</div>'+
      '<div class="rank-btns">'+
      '<button class="rank-btn" onclick="changeSkill(\''+sk+'\',-1)" '+(cur<=getBaseSkill(sk)?'disabled':'')+'>−</button>'+
      '<span class="rank-display">'+cur+'</span>'+
      '<button class="rank-btn" onclick="changeSkill(\''+sk+'\',1)" '+(cur>=4||left2<nextCost?'disabled':'')+'>+</button>'+
      '</div>';
    sl.appendChild(row);
  });

  var cl2=document.getElementById('xpCombatList');
  combatTypes.forEach(function(cp){
    var base=getCombatBase(cp);
    var cur=getCombatRank(cp);
    var left2=10-xpSpent();
    var nextCost=cur+1<=1?2:cur+1<=2?4:6;
    var row=document.createElement('div');
    row.className='xp-skill-row';
    row.innerHTML='<div class="xp-skill-name">'+cp+(base>0?' (Base '+base+')':'')+'</div>'+
      '<div class="rank-btns">'+
      '<button class="rank-btn" onclick="changeCombat(\''+cp+'\',-1)" '+(cur<=base?'disabled':'')+'>−</button>'+
      '<span class="rank-display">'+cur+'</span>'+
      '<button class="rank-btn" onclick="changeCombat(\''+cp+'\',1)" '+(cur>=3||left2<nextCost?'disabled':'')+'>+</button>'+
      '</div>';
    cl2.appendChild(row);
  });
}

function switchXPTab(tab) {
  currentXPTab=tab;
  renderXP();
}

function changeSkill(sk,d) {
  var left=10-xpSpent();
  var cur=getSkillRank(sk);
  var base=getBaseSkill(sk);
  if(d>0){
    var cost=cur+1<=1?1:cur+1<=2?2:cur+1<=3?3:5;
    if(left>=cost&&cur<4){ state.xpSkills[sk]=(state.xpSkills[sk]||0)+1; }
  } else {
    if((state.xpSkills[sk]||0)>0) state.xpSkills[sk]--;
  }
  renderXP();
}

function changeCombat(cp,d) {
  var left=10-xpSpent();
  var base=getCombatBase(cp);
  var cur=getCombatRank(cp);
  if(d>0){
    var cost=cur+1<=1?2:cur+1<=2?4:6;
    if(left>=cost&&cur<3){ state.xpCombat[cp]=(state.xpCombat[cp]||0)+1; }
  } else {
    if((state.xpCombat[cp]||0)>0) state.xpCombat[cp]--;
  }
  renderXP();
}

function renderFeatures() {
  if(!state.culture) return;
  var c=CULTURES[state.culture];
  var cl=state.calling?CALLINGS[state.calling]:null;
  var cont=document.getElementById('featurePills');
  cont.innerHTML='';
  c.features.forEach(function(f){
    var btn=document.createElement('button');
    btn.className='feature-pill'+(state.features.indexOf(f)>=0?' selected':'');
    btn.textContent=f;
    btn.onclick=function(){
      var idx=state.features.indexOf(f);
      if(idx>=0){ state.features.splice(idx,1); }
      else if(state.features.length<2){ state.features.push(f); }
      renderFeatures(); checkStep4();
    };
    cont.appendChild(btn);
  });
  if(cl){
    var span=document.createElement('span');
    span.className='feature-pill calling-feature';
    // BUGFIX: Proper Spanish translation for Calling tag
    var tagText = lang === 'es' ? ' (Vocación)' : ' (Calling)';
    span.textContent=(lang==='es'?cl.feature:cl.feature)+tagText;
    cont.appendChild(span);
  }
}

function onNameInput() {
  state.heroName=document.getElementById('heroNameInput').value.trim();
  checkStep4();
}

function checkStep4() {
  document.getElementById('btn4next').disabled=!(state.heroName&&state.features.length>=2);
}

function renderSheet() {
  if(!state.culture||!state.calling||state.attrRow===null) return;
  var c=CULTURES[state.culture];
  var cl=CALLINGS[state.calling];
  var a=c.attrSets[state.attrRow];
  var end=a.s+c.endB, hop=a.h+c.hopB, par=a.w+c.parB;
  var favs=getAllFavSkills();
  var skillNames=Object.keys(c.skills);
  var combatTypes=['Axes','Bows','Spears','Swords'];

  var skillsHtml='<div class="sheet-skills-grid">';
  skillNames.forEach(function(sk){
    var rank=getSkillRank(sk);
    var isFav=favs.indexOf(sk)>=0;
    skillsHtml+='<div class="ss-row'+(isFav?' fav':'')+'"><span class="ss-name">'+sk+(isFav?' ★':'')+'</span><span class="ss-val">'+rank+'</span></div>';
  });
  skillsHtml+='</div>';

  var combatHtml='<div class="combat-row">';
  combatTypes.forEach(function(cp){
    var total=getCombatRank(cp);
    if(total>0) combatHtml+='<div class="combat-pill">'+cp+' <span>'+total+'</span></div>';
  });
  combatHtml+='</div>';

  var featHtml='<div class="sheet-features">';
  state.features.forEach(function(f){ featHtml+='<span class="sh-feature">'+f+'</span>'; });
  
  // BUGFIX: Proper Spanish translation for Calling tag
  var tagText = lang === 'es' ? ' (Vocación)' : ' (Calling)';
  featHtml+='<span class="sh-feature calling-feat">'+(lang==='es'?cl.feature:cl.feature)+tagText+'</span>';
  featHtml+='</div>';

  var blessDesc=lang==='es'?c.blessingDescEs:c.blessingDesc;
  var featDesc=lang==='es'?cl.featureDescEs:cl.featureDesc;
  var shText=lang==='es'?cl.shadowEs:cl.shadow;

  document.getElementById('characterSheet').innerHTML=
    '<div class="sheet-wrapper">'+
      '<div class="sheet-hero-header">'+
        '<div class="sheet-hero-name">'+state.heroName+'</div>'+
        '<div class="sheet-hero-sub">'+c.name+' · '+cl.name+'</div>'+
        '<div class="sheet-valour-wisdom">'+
          '<div class="vw-badge"><div class="vw-label">'+T('valour')+'</div><div class="vw-val">1</div></div>'+
          '<div class="vw-badge"><div class="vw-label">'+T('wisdom')+'</div><div class="vw-val">1</div></div>'+
        '</div>'+
      '</div>'+
      '<div class="sheet-body">'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('attrs')+'</div>'+
          '<div class="attr-trio">'+
            '<div class="attr-block"><div class="ab-label">'+T('strength')+'</div><div class="ab-val">'+a.s+'</div><div class="ab-tn">'+T('tn')+' '+(20-a.s)+'</div></div>'+
            '<div class="attr-block"><div class="ab-label">'+T('heart')+'</div><div class="ab-val">'+a.h+'</div><div class="ab-tn">'+T('tn')+' '+(20-a.h)+'</div></div>'+
            '<div class="attr-block"><div class="ab-label">'+T('wits')+'</div><div class="ab-val">'+a.w+'</div><div class="ab-tn">'+T('tn')+' '+(20-a.w)+'</div></div>'+
          '</div>'+
        '</div>'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('derived')+'</div>'+
          '<div class="derived-trio">'+
            '<div class="der-block"><div class="db-label">'+T('endurance')+'</div><div class="db-val">'+end+'</div></div>'+
            '<div class="der-block"><div class="db-label">'+T('hope')+'</div><div class="db-val">'+hop+'</div></div>'+
            '<div class="der-block"><div class="db-label">'+T('parry')+'</div><div class="db-val">'+par+'</div></div>'+
          '</div>'+
        '</div>'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('blessing')+'</div>'+
          '<div class="sh-blessing"><strong>'+c.blessing+'</strong>'+blessDesc+'</div>'+
        '</div>'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('skills')+'</div>'+skillsHtml+
        '</div>'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('combat')+'</div>'+combatHtml+
        '</div>'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('features')+'</div>'+featHtml+
        '</div>'+
        '<div class="sheet-section">'+
          '<div class="sheet-section-title">'+T('calling')+' — '+cl.name+'</div>'+
          '<div class="sh-blessing" style="margin-bottom:10px"><strong>'+cl.feature+'</strong>'+featDesc+'</div>'+
          '<div class="sh-shadow"><strong>'+T('shadowPath')+': '+shText+'</strong>'+(lang==='es'?cl.descEs:cl.desc)+'</div>'+
        '</div>'+
      '</div>'+
    '</div>';
}

function goStep(n) {
  if(n===4) { renderFeatures(); }
  if(n===5) { state.heroName=document.getElementById('heroNameInput').value.trim(); renderSheet(); }
  document.querySelectorAll('.step').forEach(function(s){ s.classList.remove('active'); });
  document.getElementById('step'+n).classList.add('active');
  currentStep=n;
  renderProgress();
  window.scrollTo(0,0);
}

function restart() {
  state={culture:null,attrRow:null,favouredSkill:null,calling:null,callingFavs:[],xpSkills:{},xpCombat:{},heroName:'',features:[]};
  var ni=document.getElementById('heroNameInput');
  if(ni) ni.value='';
  document.getElementById('attrSection').style.display='none';
  document.getElementById('btn1next').disabled=true;
  document.getElementById('btn2next').disabled=true;
  document.getElementById('btn4next').disabled=true;
  goStep(1);
  renderAll();
}

// SHARING LOGIC
function generateShareText() {
  if(!state.culture||!state.calling||state.attrRow===null) return "";
  var c=CULTURES[state.culture];
  var cl=CALLINGS[state.calling];
  var a=c.attrSets[state.attrRow];
  var end=a.s+c.endB, hop=a.h+c.hopB, par=a.w+c.parB;
  var favs=getAllFavSkills();

  var text = "🛡️ **" + state.heroName + "** 🛡️\n";
  text += c.name + " · " + cl.name + "\n";
  text += "STR: " + a.s + " | HRT: " + a.h + " | WIT: " + a.w + "\n";
  text += "END: " + end + " | HOP: " + hop + " | PAR: " + par + "\n";
  text += "Valour: 1 | Wisdom: 1\n\n";

  text += "✨ *Skills*\n";
  var rankedSkills = [];
  Object.keys(c.skills).forEach(function(sk){
    var rank = getSkillRank(sk);
    var isFav = favs.indexOf(sk) >= 0;
    if (rank > 0 || isFav) {
      rankedSkills.push(sk + (isFav ? "★" : "") + " " + rank);
    }
  });
  text += rankedSkills.join(" · ") + "\n\n";

  text += "⚔️ *Combat Proficiencies*\n";
  var combatTypes = ['Axes','Bows','Spears','Swords'];
  var combatList = [];
  combatTypes.forEach(function(cp){
    var r = getCombatRank(cp);
    if (r > 0) combatList.push(cp + " " + r);
  });
  text += combatList.join(" · ") + "\n\n";
  text += "🎭 *Features*\n" + state.features.join(", ") + ", " + cl.feature + " (Calling)\n";

  return text;
}

function shareWa() {
  var text = encodeURIComponent(generateShareText());
  window.open('https://wa.me/?text=' + text, '_blank');
}

function shareDi() {
  var text = generateShareText();
  navigator.clipboard.writeText(text).then(function() {
    alert(T('copied'));
  }).catch(function(err) {
    console.error('Could not copy text: ', err);
  });
}

renderAll();
</script>
